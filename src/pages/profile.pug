extends layout.pug

block meta
  include ./modules/meta.pug
  title= 'Profile'

block header
  include ./modules/header.pug

block content
  include ./components/profileAvatar
  include ./modules/profile/favoriteTopics

  section.information
    .information__data
      .information__avatar
        // - Добавить рендеринг с сервера
        +profileAvatar('', 'Я')
      // - Добавить рендеринг с сервера
      .information__nickname-container
        img.information__status-image(src=require('../image/crown.svg') alt='123')
        span.information__nickname Lem0n4eLL0
    .information__characteristic
      .information__about-me
        h2.information__title О себе
        p.information__description
          |Раньше и немного сейчас я занимался кодингом на AutoHotKey (язык для макросов, но может многие вещи, работа с Excel, браузером, COM объектами, парсинг и прочее), около 5-6 лет. Я имею опыт с HTML, CSS (препроцессор SASS/SCSS), JS, MySQL, MongoDB небольшой опыт NodeJS (ExpresJS, Electron, Next), в прошлом немного PHP (но куда больше нравится JS), есть общие понимания и познания в GIT, сейчас на проекте использую React и TypeScript.
      .information__headway
        // - Разделить на блоки по файлам
        .information__headway-container.information__my-achievement
          h2.information__headway-title Achievement
          .information__my-achievement-container
            .achievement
              include ./assets/svg/star.pug
            .achievement__title Сдал все лабы по ППИ
        .information__headway-container.information__my-groups
          h2.information__headway-title Groups
          .information__my-groups-container
            ul.information__list_type_my-groups
              li.information__list-tem_type_my-groups ИВТ-21
              li.information__list-tem_type_my-groups JavaScriptery
              li.information__list-tem_type_my-groups SoMEstaff

  section.favorite
    .favorite__controls
      .favorite__button-partitions
        button.button.favorite__button_type_partitions.favorite__button_type_partitions_active(type='button') Favorite
        button.button.favorite__button_type_partitions(type='button') Goups
        button.button.favorite__button_type_partitions(type='button') My topics
    .favorite__content
      // В этом блоке будет рендерится информация относительно блока навигации favorite__controls
      +favoriteTopics()



block footer
  include ./modules/mainFooter.pug

mixin registration_form
  .auth__form
    form.form(name=`registration_form` novalidate)
      .form__content
        label.form__label
          input.input.form__input(type="text" name="user_name" placeholder=" " required)
          span.form__placeholder nickname
        label.form__label
          input.input.form__input(type="email" name="user_email" placeholder=" " required)
          span.form__placeholder email
        label.form__label
          input.input.form__input(type="password" name="user_password" placeholder=" " required)
          span.form__placeholder password
      button.button.form__button.button_color_green(type="submit" name="submit") sign up
  .auth__control
    button#button_type_open-change-form.button.auth__button(type='button') log in

extends layout.pug
//-  Исправить кал

block meta

  include ./modules/meta.pug
  title= 'Inter Flow'

block header
  include ./modules/header.pug

block content
  aside.navigator
    .navigator__container
      nav.navigator__navigtion
        ol.navigator__list
          li.navigator__list-item
            a.link.navigator__link.navigator__link_type_active(href='#') Home
          li.navigator__list-item
            a.link.navigator__link(href='#') Tags
  .content__wrapper
    section.topics
      .topics__controls
        .topics__button-partitions
          button.button.topics__button_type_partitions.topics__button_type_partitions_active(type='button') New
          button.button.topics__button_type_partitions(type='button') Top
          button.button.topics__button_type_partitions(type='button') Hot
        button.button.topics__button_type_create-topic(type='button') Create topic
      .topics__list
        .topic__container
          .topic__outside
            a.link.topic__owner(href='#owner') owner
            ul.topic__tags-list
              li.topic__tag
                button.button.tag__button(type='button') @tag1
              li.topic__tag
                button.button.tag__button(type='button') @tag2
          .topic__content
            h2.topic__title
              a.link.topic__link(href='#owner') Title
            p.topic__description Очень длинное описание карточки, которое может не поместиться в отведённое пространство и должно быть обрезано с добавлением многоточия в конце.

block footer
  include ./modules/mainFooter.pug








- const isLogin = false

header.header
  include ../components/profileAvatar
  .header__logo
    a.link(href='./')
      include ../assets/logo.pug
  .header__control
    .header__search
      include ../components/search.pug
    .header__auth
      if isLogin
        button.button.header__button.header__button_login.transition-bg-color_type_average(type='button')
          | log in
        button.button.header__button.header__button_signup.transition-bg-color_type_average(type='button')
         | sign up
      else
        .header__bell
          include ../assets/svg/bell.pug
        a.link.header__link_type_avatar(href='./profile.html')
          +profileAvatar(require('../image/avatar.jpg'), 'Я')
        include ../popaps/profileControl.pug






template#autorisation_form
  form.form(name=`autorisation_form` novalidate)
    .form__content
      label.form__label
        input.input.form__input(type="text"  name="user_name" placeholder=" " required)
        span.form__placeholder nickname
      label.form__label
        input.input.form__input(type="mail" name="user_mail" placeholder=" " required)
        span.form__placeholder email
      label.form__label
        input.input.form__input(type="password" name="user_password" placeholder=" " required)
        span.form__placeholder password
    button.button.form__button.button_color_green(type="submit" name="submit") log in

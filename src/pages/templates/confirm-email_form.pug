- const mailUrl = 'email'
template#confirm-email_form
  h2.confirm-email__title
    | Подтвердите email ->
    span.confirm-email__email
      a.confirm-email__link(href=mailUrl)=mailUrl
  form.form(name='confirm-email')
    label.form__label
      input.form__input(type="password" name="user_password" placeholder="password" required)
    button(type="submit" name="submit") Confirm

